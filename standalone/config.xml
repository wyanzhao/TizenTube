<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://github.com/wyanzhao/TizenTube" version="2.1.8" viewmodes="maximized">
    <access origin="https://youtube.com" subdomains="true"/>
    <access origin="https://googlevideo.com" subdomains="true"/>
    <access origin="https://ytimg.com" subdomains="true"/>
    <access origin="https://ggpht.com" subdomains="true"/>
    <access origin="https://gstatic.com" subdomains="true"/>
    <access origin="https://googleusercontent.com" subdomains="true"/>
    <access origin="https://googleapis.com" subdomains="true"/>
    <access origin="https://google.com" subdomains="true"/>
    <tizen:allow-navigation href="https://*.youtube.com/* https://youtube.com/* https://accounts.google.com/* https://www.google.com/*"/>
    <tizen:application id="TizenTubeS.TizenTube" package="TizenTubeS" required_version="3.0"/>
    <author href="https://github.com/wyanzhao/TizenTube">TizenTube contributors (fork of reisxd/TizenTube)</author>
    <content src="index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <icon src="icon_16b9.png" width="1920" height="1080"/>
    <icon src="icon.png" width="1024" height="1024"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/floating.navigation" value="false"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/use.uwe" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/no_use_process_pool" value="true"/>
    <tizen:metadata key="multiview_support" value="true"/>
    <tizen:metadata key="multiview_min_resource" value="FHD+"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/html5.4k.support" value="true"/>
    <name>TizenTube</name>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/pkgid" value="com.samsung.tv.cobalt"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/nativeID" value="com.samsung.tv.cobalt-yt"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/native.userdata" value="--base_url=https://www.youtube.com/tv --proxy=http://127.0.0.2:8101 --content=/home/owner/share/tizentube-content --dial_name=YouTube --use_eden"/>
    <tizen:profile name="tv-samsung"/>
    <tizen:service id="TizenTubeS.StandaloneService" auto-restart="true" on-boot="true">
        <tizen:content src="service/index.js"/>
        <tizen:name>StandaloneService</tizen:name>
        <tizen:description>StandaloneService</tizen:description>
    </tizen:service>
    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
